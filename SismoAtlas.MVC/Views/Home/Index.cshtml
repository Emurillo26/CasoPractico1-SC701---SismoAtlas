@using SismoAtlas.DTO
@using System.Globalization
@using System.Text.RegularExpressions

@*
    SismoAtlas: vista principal.
    Se conserva el diseño de Engel y se conectan sus componentes
    a los resultados enviados por HomeController mediante ViewBag.Resultado.
*@

@{
    ViewData["Title"] = "Explora los sismos de un país";

    var paisBuscado = ViewBag.PaisBuscado as string ?? "";
    var resultado = ViewBag.Resultado as CountryEarthquakesDto;
    var paisInfo = resultado?.Country;
    var sismos = resultado?.Earthquakes ?? new List<EarthquakeDto>();
    var cultura = CultureInfo.GetCultureInfo("es-CR");

    // Primera visita: conservar los ejemplos del diseño original de Engel.
    // Después de buscar: mostrar datos reales o errores, nunca ejemplos falsos.
    var primeraVisita = !Context.Request.Query.ContainsKey("pais");
    var mostrarResultados = primeraVisita || resultado != null;

    var magnitudes = sismos.Where(s => s.Magnitude.HasValue)
                           .Select(s => s.Magnitude!.Value).ToList();
    decimal? magnitudMaxima = magnitudes.Count > 0 ? magnitudes.Max() : null;

    var profundidades = sismos.Where(s => s.Depth.HasValue)
                             .Select(s => s.Depth!.Value).ToList();
    double? profundidadPromedio = profundidades.Count > 0 ? profundidades.Average() : null;

    var codigoPais = paisInfo?.Cca2?.ToLowerInvariant() ?? "";
    var mapaDisponible = Regex.IsMatch(codigoPais, @"^[a-z]{2}$");
}

<!-- ===== Hero con el buscador (diseño de Engel) ===== -->
<section class="hero">
    <div class="container hero-inner">
        <span class="pill">Actividad sísmica por país</span>
        <h1>Explora los sismos de un país</h1>
        <p class="hero-sub">Consulta registros históricos y conoce más sobre cada destino.</p>

        <form class="search" method="get" asp-controller="Home" asp-action="Index" id="formBusqueda" novalidate>
            <svg class="search-icon" viewBox="0 0 24 24" aria-hidden="true">
                <circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2" />
                <line x1="16.5" y1="16.5" x2="21" y2="21" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
            </svg>
            <label for="pais" class="sr-only">Nombre del país</label>
            <input type="text" id="pais" name="pais" maxlength="100"
                   placeholder="Escribe un país, por ejemplo Costa Rica"
                   autocomplete="off" value="@paisBuscado" />
            <button type="submit" class="btn-search">Buscar</button>
        </form>
        <p class="search-hint">Escribe únicamente el nombre de un país · Máximo 100 caracteres.</p>
    </div>
</section>

@if (mostrarResultados)
{
    <!-- ===== Resultados ===== -->
    <section class="results">
        <div class="container results-grid">

            <!-- Columna izquierda: estadísticas y sismos -->
            <div class="results-main">
                <h2 class="results-title">Sismos en @(primeraVisita ? "Costa Rica" : (paisInfo?.Name ?? paisBuscado))</h2>
                <p class="results-sub">
                    @(primeraVisita ? "3 resultados de ejemplo." : $"{sismos.Count} {(sismos.Count == 1 ? "registro encontrado" : "registros encontrados")}")
                </p>

                <div class="stats">
                    <div class="stat">
                        <span class="stat-value">@(primeraVisita ? "3" : sismos.Count.ToString("N0", cultura))</span>
                        <span class="stat-label">Registros</span>
                    </div>
                    <div class="stat">
                        <span class="stat-value">@(primeraVisita ? "5,2" : (magnitudMaxima?.ToString("0.0", cultura) ?? "—"))</span>
                        <span class="stat-label">Magnitud máxima</span>
                    </div>
                    <div class="stat">
                        <span class="stat-value">@(primeraVisita ? "18 km" : (profundidadPromedio.HasValue ? $"{profundidadPromedio.Value.ToString("0.0", cultura)} km" : "—"))</span>
                        <span class="stat-label">Profundidad media</span>
                    </div>
                </div>

                <div class="table-card">
                    <table class="quake-table">
                        <thead>
                            <tr>
                                <th>Magnitud</th>
                                <th>Ubicación</th>
                                <th>Fecha</th>
                                <th>Profundidad</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (primeraVisita)
                            {
                                @* Los ejemplos originales solo aparecen al abrir la página, antes de buscar. *@
                                <tr>
                                    <td data-label="Magnitud"><span class="mag mag-alta">5,2</span></td>
                                    <td data-label="Ubicación">Cerca de Jacó</td>
                                    <td data-label="Fecha">08 oct 2026</td>
                                    <td data-label="Profundidad">22 km</td>
                                </tr>
                                <tr>
                                    <td data-label="Magnitud"><span class="mag mag-media">4,1</span></td>
                                    <td data-label="Ubicación">Al sur de Quepos</td>
                                    <td data-label="Fecha">06 oct 2026</td>
                                    <td data-label="Profundidad">15 km</td>
                                </tr>
                                <tr>
                                    <td data-label="Magnitud"><span class="mag mag-baja">3,6</span></td>
                                    <td data-label="Ubicación">Cerca de Golfito</td>
                                    <td data-label="Fecha">03 oct 2026</td>
                                    <td data-label="Profundidad">17 km</td>
                                </tr>
                            }
                            else if (sismos.Count > 0)
                            {
                                @foreach (var sismo in sismos)
                                {
                                    var claseMagnitud = sismo.Magnitude >= 5 ? "mag-alta" :
                                    sismo.Magnitude >= 4 ? "mag-media" : "mag-baja";
                                    <tr>
                                        <td data-label="Magnitud">
                                            <span class="mag @claseMagnitud">@(sismo.Magnitude?.ToString("0.0", cultura) ?? "—")</span>
                                        </td>
                                        <td data-label="Ubicación">@(string.IsNullOrWhiteSpace(sismo.Place) ? "No disponible" : sismo.Place)</td>
                                        <td data-label="Fecha">@sismo.Time.ToString("dd MMM yyyy HH:mm", cultura)</td>
                                        <td data-label="Profundidad">@(sismo.Depth.HasValue ? $"{sismo.Depth.Value.ToString("0.0", cultura)} km" : "—")</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="4">No hay sismos registrados para este país en la base de datos.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <p class="table-note">
                    @(primeraVisita ? "Datos ilustrativos para el diseño." : "Fuente: registros USGS disponibles en la base de datos de SismoAtlas.")
                </p>
            </div>

            <!-- Columna derecha: información del país -->
            @if (primeraVisita)
            {
                @* Tarjeta de ejemplo original de Engel, solo en la primera visita. *@
                <aside class="country-card" aria-label="Información del país">
                    <div class="country-body">
                        <img class="country-map" src="https://cdn.jsdelivr.net/gh/djaiss/mapsicon/all/cr/vector.svg"
                             alt="" aria-hidden="true" onerror="this.remove()" />
                        <img class="country-flag" src="https://flagcdn.com/w320/cr.png" alt="Bandera de Costa Rica" />
                        <h3 class="country-name">Costa Rica</h3>
                        <p class="country-region">América Central</p>
                        <dl class="country-data">
                            <div><dt>Capital</dt><dd>San José</dd></div>
                            <div><dt>Idioma</dt><dd>Español</dd></div>
                            <div><dt>Moneda</dt><dd>Colón costarricense</dd></div>
                            <div><dt>Región</dt><dd>América</dd></div>
                            <div><dt>Población</dt><dd>5 105 525</dd></div>
                        </dl>
                    </div>
                    <div class="country-footer">
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="1.8" />
                            <ellipse cx="12" cy="12" rx="4" ry="9" fill="none" stroke="currentColor" stroke-width="1.8" />
                            <line x1="3" y1="12" x2="21" y2="12" stroke="currentColor" stroke-width="1.8" />
                        </svg>
                        <span>Información del país</span>
                    </div>
                </aside>
            }
            else if (paisInfo != null)
            {
                @* Misma tarjeta del diseño, con datos reales de REST Countries. *@
                <aside class="country-card" aria-label="Información del país">
                    <div class="country-body">
                        @if (mapaDisponible)
                        {
                            <img class="country-map" src="https://cdn.jsdelivr.net/gh/djaiss/mapsicon/all/@codigoPais/vector.svg"
                                 alt="" aria-hidden="true" onerror="this.remove()" />
                        }
                        @if (!string.IsNullOrWhiteSpace(paisInfo.FlagUrl))
                        {
                            <img class="country-flag" src="@paisInfo.FlagUrl" alt="Bandera de @paisInfo.Name" />
                        }
                        <h3 class="country-name">@paisInfo.Name</h3>
                        <p class="country-region">@(paisInfo.Subregion ?? paisInfo.Region ?? "No disponible")</p>
                        <dl class="country-data">
                            <div><dt>Capital</dt><dd>@(paisInfo.Capital ?? "No disponible")</dd></div>
                            <div><dt>Idioma</dt><dd>@(paisInfo.Languages?.Count > 0 ? string.Join(", ", paisInfo.Languages) : "No disponible")</dd></div>
                            <div><dt>Moneda</dt><dd>@(paisInfo.Currencies?.Count > 0 ? string.Join(", ", paisInfo.Currencies) : "No disponible")</dd></div>
                            <div><dt>Región</dt><dd>@(paisInfo.Region ?? "No disponible")</dd></div>
                            <div><dt>Población</dt><dd>@(paisInfo.Population?.ToString("N0", cultura) ?? "No disponible")</dd></div>
                        </dl>
                    </div>
                    <div class="country-footer">
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="1.8" />
                            <ellipse cx="12" cy="12" rx="4" ry="9" fill="none" stroke="currentColor" stroke-width="1.8" />
                            <line x1="3" y1="12" x2="21" y2="12" stroke="currentColor" stroke-width="1.8" />
                        </svg>
                        <span>Información del país</span>
                    </div>
                </aside>
            }
        </div>
    </section>
}

@* ===== Errores del HomeController: SweetAlert2 ===== *@
@section Scripts {
    @if (ViewBag.Error is string mensajeError)
    {
        <script>
            Swal.fire({
                icon: 'error',
                title: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(string.IsNullOrEmpty(paisBuscado) ? "Búsqueda inválida" : "No se pudo completar la búsqueda")),
                text: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(mensajeError)),
                confirmButtonText: 'Aceptar'
            });
        </script>
    }
}
